{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "analysis-worker",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/worker-*.js"]
      }
    },
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "samples",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/samples/**"]
      }
    }
  ]
}
