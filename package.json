{
  "name": "orrery",
  "version": "0.0.0",
  "private": true,
  "description": "A 3D solar-system explorer for Angular codebases.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "fixtures/*"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:stats": "ng build --stats-json",
    "check:bundle": "node scripts/check-bundle.mjs",
    "watch": "ng build --watch --configuration development",
    "orrery": "tsx tools/cli/src/main.ts",
    "samples": "tsx tools/cli/src/main.ts sample all",
    "test": "npm run test:packages && npm run test:web",
    "test:packages": "vitest run",
    "test:web": "ng test --watch=false",
    "e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces && tsc -p apps/web/tsconfig.app.json --noEmit && tsc -p apps/web/tsconfig.worker.json --noEmit && tsc -p apps/web/tsconfig.spec.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.3",
    "@orrery/contracts": "0.0.0",
    "@orrery/fixture-shop": "0.0.0",
    "@orrery/graph-core": "0.0.0",
    "@orrery/layout": "0.0.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vite": "8.3.5"
  }
}
